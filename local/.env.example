# local/.env.example -- template for the values docker-compose.yml interpolates.
#
# Copy this file to `.env` (same directory) and fill in real, throwaway-local
# values. `.env` is gitignored (see local/.gitignore) and must never be committed.
# docker-compose.yml itself has no hardcoded credentials -- every secret flows in
# from here via ${VAR} interpolation.

# --- Database ---
# These three also become the postgres container's own POSTGRES_DB/POSTGRES_USER/
# POSTGRES_PASSWORD (see docker-compose.yml) -- one source of truth, so the
# backend's DB_* env vars can never drift out of sync with the database itself.
DB_NAME=conduit
DB_USERNAME=conduit
DB_PASSWORD=changeme

# --- Backend ---
# jwt.secret has NO default in application.properties (${JWT_SECRET} with no
# fallback) -- the backend fails fast on startup if this is unset. Generate a
# real random value for local use, e.g.:
#   openssl rand -base64 48
# Do not reuse this placeholder, and do not reuse any value from another
# environment.
JWT_SECRET=changeme-generate-a-real-value

# --- Host ports ---
# Only backend and frontend are published to the host, so you can curl them
# directly; postgres is deliberately NOT published (see docker-compose.yml
# comment) -- backend reaches it over the compose network as postgres:5432.
FRONTEND_HOST_PORT=8080
BACKEND_HOST_PORT=8081
BACKEND_MANAGEMENT_HOST_PORT=8091
