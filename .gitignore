local
local/.env

# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# ...but *.tfvars.example files are safe, checked-in templates with no real values -
# re-include them with a negation pattern so contributors always have a starting point.
!*.tfvars.example

# .terraform.lock.hcl must stay committed - don't ignore it, that's how CI and
# your laptop end up resolving different provider versions.

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Ignore saved plan files from `terraform plan -out=<file>` (e.g. tfplan.out, used
# when capturing plan output for human review before an approved apply). These are
# binary, environment-specific, and can embed sensitive attribute values from state
# -- never source, never committed.
*.tfplan
tfplan
tfplan.out
*tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Optional: ignore graph output files generated by `terraform graph`
# *.dot

# Optional: ignore plan files saved before destroying Terraform configuration
# Uncomment the line below if you want to ignore planout files.
# planout